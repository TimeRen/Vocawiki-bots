[Unit]
Description=Run Vocawiki contribution list maintenance once
Documentation=https://github.com/TimeRen/Vocawiki-bots
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 改成你的实际部署路径
WorkingDirectory=/opt/Vocawiki-bots
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
# Attach voca-contributions.timer to run this service hourly.
ExecStart=/opt/Vocawiki-bots/.venv/bin/python bots/vocaloid_collection_contributions.py all --write
# 运行用户（需能读写 /opt/Vocawiki-bots 与 user-password.py）
User=voca-bot
Group=voca-bot

[Install]
WantedBy=multi-user.target
